# =============================================================================
# Store-IO - Environment Configuration
# =============================================================================
# Copy this file to .env (`cp .env.example .env`) and adjust as needed.
#
# Consumed by docker compose (published host ports) and by the service settings
# in services/shared, services/order and services/warehouse.

# ===== Application ===== #
ENVIRONMENT=development
LOG_LEVEL=INFO

# ===== PostgreSQL - Order Service ===== #
ORDER_POSTGRES_HOST=order-db-service
ORDER_POSTGRES_PORT=5432
ORDER_POSTGRES_DB=order_service_db
ORDER_POSTGRES_USER_FILE=.secrets/postgres/order-service/postgres_user
ORDER_POSTGRES_PASSWORD_FILE=.secrets/postgres/order-service/postgres_password

# ===== PostgreSQL - Warehouse Service ===== #
WAREHOUSE_POSTGRES_HOST=warehouse-db-service
WAREHOUSE_POSTGRES_PORT=5432
WAREHOUSE_POSTGRES_DB=warehouse_service_db
WAREHOUSE_POSTGRES_USER_FILE=.secrets/postgres/warehouse-service/postgres_user
WAREHOUSE_POSTGRES_PASSWORD_FILE=.secrets/postgres/warehouse-service/postgres_password

# ===== Redis (redis-service) ===== #
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD_FILE=.secrets/redis/redis_password

# ===== RabbitMQ (rabbitmq-service) ===== #
RABBITMQ_HOST=rabbitmq-service
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ===== Warehouse Service (called by Orders for live prices.) ===== #
# This value is used when the order service runs on the host. docker-compose.yml
# sets it to http://warehouse-service:8000 (the internal service name) for the
# container, so it never depends on the published host port.
WAREHOUSE_SERVICE_URL=http://localhost:8001
WAREHOUSE_TIMEOUT_SECONDS=2.0

# ===== Fault injection (Chaos Monkey) - Spec Requirement. ===== #
# Enable to show resilience: requests randomly slow down or return 503.
ENABLE_GLITCH_SIMULATION=false
GLITCH_PROBABILITY=0.2

# ===== Docker Compose published host ports ===== #
ORDER_SERVICE_PORT=8000
WAREHOUSE_SERVICE_PORT=8001
ORDER_DB_PORT=5432
WAREHOUSE_DB_PORT=5433
DASHBOARD_PORT=5173
CONTROL_SERVICE_PORT=8010
